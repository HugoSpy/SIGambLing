generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  validator
  admin
}

enum EventStatus {
  OPEN      @map("active")
  CLOSED    @map("pending")
  RESOLVED  @map("resolved")
  CANCELLED @map("cancelled")
}

enum BetStatus {
  pending
  won
  lost
  cancelled
}

enum BetType {
  SIMPLE
  PARLAY
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CasinoGameType {
  roulette
  blackjack
  hilo
  ride_the_bus
  mines
}

enum CasinoGameResult {
  win
  loss
  push
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(255)
  microsoftId     String?     @unique @db.VarChar(255)
  pseudo          String      @unique @db.VarChar(50)
  avatarUrl       String?     @db.VarChar(500)
  balance         Int         @default(1000)
  role            UserRole    @default(user)
  isBanned        Boolean     @default(false)
  sessionVersion  Int         @default(0)
  lastRewardAt    DateTime?
  streakDays      Int         @default(0)
  acceptOddsChanges Boolean   @default(false)
  lastSeenAt      DateTime?
  chatPanelWidth   Int?
  chatPanelHeight  Int?
  chatPanelX       Int?
  chatPanelY       Int?
  chatZoom         Int?
  themePreference  String      @default("dark")
  createdAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  bets            Bet[]
  casinoGames     CasinoGame[]
  badges          Badge[]
  createdEvents   Event[]     @relation("EventCreator")
  validatedEvents Event[]     @relation("EventValidator")
  excludedEvents  EventExclusion[]
  adminLogs       AdminLog[]  @relation("AdminActor")
  proposals       EventProposal[]
  reviewedProposals EventProposal[] @relation("ProposalReviewer")
  jackpotContributions JackpotContribution[]
  wonJackpotSnapshots Jackpot[] @relation("JackpotLastWinner")
  jackpotContributionTotal Int         @default(0)
  lowestBalance   Int         @default(1000)
  chatMessages    ChatMessage[]
  chatBan         ChatBan?

  @@index([email])
  @@index([balance(sort: Desc)])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.VarChar(300)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model ChatBan {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  banCount   Int       @default(0)
  mutedUntil DateTime?
  permanent  Boolean   @default(false)
  updatedAt  DateTime  @updatedAt
}

model Event {
  id             String           @id @default(uuid()) @db.Uuid
  title          String           @unique @db.VarChar(200)
  description    String?          @db.Text
  imageUrl       String?          @db.VarChar(500)
  options        Json
  poolByOption   Json             @default("{}")
  totalPool      Int              @default(0)
  status         EventStatus      @default(OPEN)
  resolvedOption String?          @map("resultOption") @db.VarChar(50)
  closingAt      DateTime?        @map("resolutionDate")
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  minBet         Int              @default(10)
  maxBet         Int?
  createdById    String?          @map("creatorId") @db.Uuid
  validatorId    String?          @db.Uuid
  validatedAt    DateTime?
  createdBy      User?            @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  validator      User?            @relation("EventValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  excludedUsers  EventExclusion[]
  bets           Bet[]
  oddsHistories  OddsHistory[]
  betLegs        BetLeg[]

  @@index([status])
  @@index([closingAt])
  @@index([createdAt(sort: Desc)])
}

model Bet {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  eventId      String?   @db.Uuid
  chosenOption String?   @map("selectedOption") @db.VarChar(100)
  amount       Int
  oddAtBet     Decimal?  @map("oddsAtBet") @db.Decimal(8, 4)
  status       BetStatus @default(pending)
  type         BetType   @default(SIMPLE)
  potentialWin Int       @default(0)
  payout       Int       @map("actualWin") @default(0)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  legs         BetLeg[]

  @@index([userId])
  @@index([eventId])
  @@index([type, status])
  @@index([createdAt(sort: Desc)])
}

model BetLeg {
  id           String    @id @default(uuid()) @db.Uuid
  betId        String    @db.Uuid
  eventId      String    @db.Uuid
  chosenOption String    @db.VarChar(100)
  oddsAtBet    Decimal   @db.Decimal(8, 4)
  status       BetStatus @default(pending)
  bet          Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  event        Event     @relation(fields: [eventId], references: [id])

  @@index([betId])
  @@index([eventId])
}

model OddsHistory {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  option      String   @db.VarChar(100)
  odds        Decimal  @db.Decimal(8, 4)
  totalStaked Int
  timestamp   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, option])
  @@index([timestamp(sort: Desc)])
}

model EventProposal {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  title           String         @db.VarChar(200)
  description     String?        @db.Text
  suggestedDate   DateTime?
  options         String[]       @default([])
  status          ProposalStatus @default(PENDING)
  savedByAdmin    Boolean        @default(false)
  reviewedById    String?        @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?          @relation("ProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model EventExclusion {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  userId  String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model CasinoGame {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  gameType  CasinoGameType
  betAmount Int
  result    CasinoGameResult
  payout    Int              @default(0)
  gameData  Json
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Badge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  badgeType   String    @db.VarChar(50)
  unlockedAt  DateTime  @default(now())
  claimedAt   DateTime?
  pinned      Boolean   @default(false)
  pinnedOrder Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
}

model Jackpot {
  id                  String                @id @default(cuid())
  currentAmount       Float                 @default(0)
  contributionRateBps Int                   @default(100)
  totalContributed    Float                 @default(0)
  lastWinnerId        String?               @db.Uuid
  lastWinAmount       Float?
  lastWinAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastWinner          User?                 @relation("JackpotLastWinner", fields: [lastWinnerId], references: [id], onDelete: SetNull)
  contributions       JackpotContribution[]

  @@index([lastWinnerId])
}

model JackpotContribution {
  id                 String   @id @default(uuid()) @db.Uuid
  jackpotId          String
  userId             String   @db.Uuid
  sourceType         String   @db.VarChar(50)
  sourceReference    String?  @db.VarChar(100)
  wagerAmount        Int
  contributionAmount Float
  createdAt          DateTime @default(now())
  jackpot            Jackpot  @relation(fields: [jackpotId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jackpotId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @db.Uuid
  actionType String   @db.VarChar(50)
  targetId   String?  @db.Uuid
  details    Json?
  createdAt  DateTime @default(now())
  admin      User?    @relation("AdminActor", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt(sort: Desc)])
}

model RewindLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @db.Uuid
  adminId       String   @db.Uuid
  rewindedAt    DateTime @default(now())
  affectedUsers Json

  @@index([eventId])
  @@index([adminId])
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
